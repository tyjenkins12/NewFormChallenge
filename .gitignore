# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# .env* (commented out to allow committing .env for private repo)

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Development and test files
test-*.js
*.log
dev.log

# Generated reports and PDFs
/public/reports/*.html
/public/reports/*.pdf
report-*.pdf
report-*.html

# Scheduler state
.scheduler-config.json
.report-generation.lock

# IDE
.idea/
.vscode/
